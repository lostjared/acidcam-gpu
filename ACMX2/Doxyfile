# Doxyfile for ACMX — Delphi / Borland–themed documentation
#
# Generate with:   doxygen Doxyfile
#
# Version 2.135.0 (September 2026)
# Documents the shared interface and both the ACMX2/OpenGL and ACMXVK/Vulkan
# rendering backends.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "ACMX"
PROJECT_NUMBER         = "2.135.0"
PROJECT_BRIEF          = "Dual-Backend Real-Time GPU Video Synthesis"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = . \
                         ../ACMXVK
FILE_PATTERNS          = *.cpp *.hpp *.h *.dox *.md
RECURSIVE              = YES
EXCLUDE                = build \
                         ACMX2/build \
                         build-nocuda \
                         docs \
                         ../ACMXVK/build \
                         ../ACMXVK/docs
EXCLUDE_PATTERNS       = */CMakeFiles/* \
                         */build/* \
                         */*_autogen/* \
                         */moc_*.cpp \
                         */qrc_*.cpp \
                         */mocs_compilation.cpp \
                         */ui_*.h \
                         */__pycache__/*
EXTENSION_MAPPING      = dox=C++

#---------------------------------------------------------------------------
# Parsing
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES

#---------------------------------------------------------------------------
# Build
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = AUDIO_ENABLED \
                         MIDI_ENABLED
EXPAND_ONLY_PREDEF     = NO
SKIP_FUNCTION_MACROS   = YES

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# HTML output — light Delphi/Borland theme
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = versions/2.135.0
HTML_EXTRA_STYLESHEET  = doxygen-custom.css
HTML_COLORSTYLE        = LIGHT
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 60
HTML_COLORSTYLE_GAMMA  = 80
HTML_DYNAMIC_SECTIONS  = YES
HTML_INDEX_NUM_ENTRIES = 100
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 280
FULL_SIDEBAR           = YES
USE_MATHJAX            = YES

#---------------------------------------------------------------------------
# LaTeX / other output (disabled)
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO

#---------------------------------------------------------------------------
# Diagrams
#---------------------------------------------------------------------------
HAVE_DOT               = NO

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES

#---------------------------------------------------------------------------
# Miscellaneous
#---------------------------------------------------------------------------
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = ..
