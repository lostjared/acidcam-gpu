#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D input_image;

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
};

layout(set = 0, binding = 5, rgba8) writeonly uniform image2D output_image;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 output_size = imageSize(output_image);
    if (any(greaterThanEqual(pixel, output_size))) {
        return;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(output_size);
    vec4 color = texture(input_image, uv);
    float pulse = 0.5 + 0.5 * sin(u2.y * 2.0);
    vec3 inverted = vec3(1.0) - color.rgb;
    imageStore(output_image, pixel,
               vec4(mix(color.rgb, inverted, 0.25 + pulse * 0.5), color.a));
}
