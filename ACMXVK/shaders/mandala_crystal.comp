#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;

layout(set = 0, binding = 5, rgba8) writeonly uniform image2D output_image;

#define slider1 ext.custom_uniforms[5].x
#define slider2 ext.custom_uniforms[5].y
#define slider3 ext.custom_uniforms[5].z
#define slider4 ext.custom_uniforms[5].w

const float TAU = 6.28318530718;

vec3 palette(float phase) {
    return 0.5 + 0.5 * cos(TAU * (phase + vec3(0.0, 0.32, 0.67)));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(output_image);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec4 controls = clamp(vec4(slider1, slider2, slider3, slider4), 0.0, 1.0);
    vec2 point = (2.0 * (vec2(pixel) + 0.5) - vec2(size)) / float(min(size.x, size.y));
    float radius = length(point);
    float angle = atan(point.y, point.x + 0.000001);
    float time = ext.u2.y * mix(0.04, 0.45, controls.z);
    float symmetry = floor(mix(6.0, 24.0, controls.x) + 0.5);
    vec3 color = vec3(0.005, 0.008, 0.02);

    float sector = TAU / symmetry;
    float folded = abs(mod(angle + time * 0.12 + sector * 0.5, sector) - sector * 0.5);
    vec2 orbit = vec2(cos(folded), sin(folded)) * radius * mix(1.6, 3.4, controls.y);
    float weight = 1.0;
    for (int iteration = 0; iteration < 9; ++iteration) {
        float index = float(iteration);
        orbit = abs(orbit) / max(dot(orbit, orbit), 0.16)
              - vec2(0.92, 0.48 + 0.09 * sin(time * 0.4 + index));
        float rotation = 0.5 + 0.15 * sin(time * 0.3);
        float sine_value = sin(rotation);
        float cosine_value = cos(rotation);
        orbit = mat2(cosine_value, -sine_value, sine_value, cosine_value) * orbit;
        float ring = abs(length(orbit) - 0.65);
        float cross_line = min(abs(orbit.x), abs(orbit.y));
        float trap = exp(-ring * mix(22.0, 55.0, controls.y));
        trap += 0.35 * exp(-cross_line * 65.0);
        color += palette(controls.w + index * 0.13 + radius * 0.2 + time * 0.03)
               * trap * weight;
        weight *= 0.76;
    }
    float spokes = pow(0.5 + 0.5 * cos(folded * symmetry * 2.0), 24.0);
    color += palette(controls.w + 0.3) * spokes * exp(-radius * 2.0) * 0.22;
    color *= exp(-radius * radius * 0.6);
    color = vec3(1.0) - exp(-color * 1.65);
    imageStore(output_image, pixel, vec4(color, 1.0));
}
