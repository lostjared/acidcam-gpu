#version 450

// Complex kaleidoscopic fractal controlled by the four standard ACMXVK MIDI
// slider uniforms. The effect uses source/media time from u2.y, so offline and
// real-time processing produce the same animation at the same source position.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D input_image;

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;

layout(set = 0, binding = 5, rgba8) writeonly uniform image2D output_image;

#define slider1 ext.custom_uniforms[5].x
#define slider2 ext.custom_uniforms[5].y
#define slider3 ext.custom_uniforms[5].z
#define slider4 ext.custom_uniforms[5].w

const float PI = 3.14159265358979323846;
const float TAU = 6.28318530717958647692;

mat2 rotate2d(float angle) {
    float sine_value = sin(angle);
    float cosine_value = cos(angle);
    return mat2(cosine_value, -sine_value, sine_value, cosine_value);
}

vec3 palette(float value) {
    vec3 phase = vec3(0.02, 0.31, 0.63);
    return 0.52 + 0.48 * cos(TAU * (value + phase));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 output_size = imageSize(output_image);
    if (any(greaterThanEqual(pixel, output_size))) {
        return;
    }

    vec2 size = max(vec2(output_size), vec2(1.0));
    vec2 uv = (vec2(pixel) + vec2(0.5)) / size;
    vec2 point = uv * 2.0 - 1.0;
    point.x *= size.x / size.y;

    float symmetry_control = clamp(slider1, 0.0, 1.0);
    float detail_control = clamp(slider2, 0.0, 1.0);
    float motion_control = clamp(slider3, 0.0, 1.0);
    float blend_control = clamp(slider4, 0.0, 1.0);

    float symmetry = floor(mix(4.0, 20.0, symmetry_control) + 0.5);
    int iterations = int(floor(mix(3.0, 10.0, detail_control) + 0.5));
    float time_value = ext.u2.y * mix(0.04, 0.7, motion_control);

    float radius = length(point);
    float angle = atan(point.y, point.x) + time_value * 0.28;
    float sector = TAU / symmetry;
    float folded_angle = abs(mod(angle + sector * 0.5, sector) - sector * 0.5);

    vec2 fractal_point =
        vec2(cos(folded_angle), sin(folded_angle)) * radius;
    fractal_point *= mix(2.2, 4.8, detail_control);
    fractal_point += vec2(-0.72, 0.18 + 0.12 * sin(time_value));

    float orbit_glow = 0.0;
    float edge_glow = 0.0;
    float phase_accumulator = 0.0;
    float scale_accumulator = 1.0;

    for (int index = 0; index < 10; ++index) {
        if (index >= iterations) {
            break;
        }

        fractal_point = abs(fractal_point);
        float magnitude_squared = max(dot(fractal_point, fractal_point), 0.075);
        fractal_point = fractal_point / magnitude_squared;
        fractal_point -= vec2(0.82 + 0.18 * detail_control,
                              0.44 - 0.12 * symmetry_control);

        float iteration_angle =
            0.22 + motion_control * 0.55 + time_value * 0.025;
        fractal_point = rotate2d(iteration_angle) * fractal_point;

        float orbit = length(fractal_point);
        float ring = abs(orbit - mix(0.72, 1.18, detail_control));
        orbit_glow += exp(-ring * mix(7.0, 15.0, detail_control)) /
                      scale_accumulator;
        edge_glow += exp(-abs(fractal_point.x * fractal_point.y) * 9.0) /
                     scale_accumulator;
        phase_accumulator += atan(fractal_point.y, fractal_point.x) * 0.12 +
                             orbit * 0.08;
        scale_accumulator *= 1.34;
    }

    float spokes = 0.5 + 0.5 * cos(folded_angle * symmetry * 2.0 -
                                    radius * mix(18.0, 42.0, detail_control) +
                                    time_value * 1.8);
    float rings = 0.5 + 0.5 * cos(radius * mix(30.0, 78.0, detail_control) -
                                  time_value * 2.2 + orbit_glow * 2.5);
    float lace = smoothstep(0.18, 0.92, orbit_glow * 0.72 + edge_glow * 0.34);
    float mandala_mask = clamp(lace * 0.72 + spokes * rings * 0.48, 0.0, 1.0);

    float color_phase = phase_accumulator + radius * 1.7 +
                        folded_angle * symmetry / PI + time_value * 0.12;
    vec3 fractal_color = palette(color_phase);
    fractal_color *= 0.34 + 1.05 * mandala_mask;
    fractal_color += palette(color_phase + 0.37) * orbit_glow * 0.13;

    float source_twist =
        motion_control * 0.42 * exp(-radius * 1.35) * sin(radius * 8.0 - time_value);
    vec2 source_point = rotate2d(source_twist) * point;
    source_point += normalize(source_point + vec2(0.0001)) *
                    (mandala_mask - 0.5) * motion_control * 0.055;
    source_point.x /= size.x / size.y;
    vec2 source_uv = clamp(source_point * 0.5 + 0.5, vec2(0.0), vec2(1.0));
    vec4 source = texture(input_image, source_uv);

    vec3 integrated_color =
        source.rgb * mix(vec3(0.72), fractal_color * 1.2, mandala_mask * 0.62) +
        fractal_color * mandala_mask * 0.46;
    integrated_color = integrated_color / (vec3(1.0) + integrated_color * 0.28);

    vec3 final_color = mix(source.rgb, integrated_color, blend_control);
    imageStore(output_image, pixel,
               vec4(clamp(final_color, vec3(0.0), vec3(1.0)), source.a));
}
